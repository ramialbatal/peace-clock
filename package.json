{
  "name": "peace-clock",
  "version": "1.0.0",
  "private": true,
  "description": "Live clock of world military spending, next to the lives lost to war and what the same money could pay for.",
  "type": "module",
  "license": "MIT",
  "author": "Rami Albatal",
  "repository": {
    "type": "git",
    "url": "https://github.com/ramialbatal/peace-clock.git"
  },
  "homepage": "https://ramialbatal.github.io/peace-clock/",
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p jsconfig.json",
    "style": "node scripts/check-style.js",
    "smoke": "node scripts/smoke.js",
    "check": "npm run style && npm run typecheck && npm test",
    "serve": "python3 -m http.server 8000",
    "og-image": "node scripts/og-image.js"
  },
  "devDependencies": {
    "clock-core": "github:ramialbatal/clock-core#84e352e5510444ec758efc82d2b522de74582b3d",
    "playwright": "1.48.2",
    "typescript": "5.6.3"
  },
  "smoke": {
    "ticking": [
      "#world-num"
    ],
    "verdicts": [
      "#answer-title"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
